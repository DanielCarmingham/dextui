target/
.DS_Store

# Claude Code's own working files. Cargo.toml excludes these from the crate
# too -- they describe how the repo is worked on, not what it builds.
.claude/

# Generated by GitNexus, and a copy of the block it also maintains in
# CLAUDE.md. Tracking it would mean keeping two copies honest.
AGENTS.md

# Bytecode from the scripts/ helpers -- screenshot.py is imported as a module
# by anything checking its rendering, which leaves one of these behind.
__pycache__/

# This repo's own dex store. dex resolves it from the cwd, so working on dextui
# from here creates one; it is a local task list, not part of the project.
.dex/
